#!/bin/sh
# auto-bmad <command> [args] — runs scripts/<command>.py of this plugin.
# bin/ of an enabled plugin is on PATH of the Bash tool; outside Claude Code call it by path.
set -e
here=$(cd "$(dirname "$0")/.." && pwd -P)
if [ "${1:-}" = "--executor" ]; then
  case "${2:-}" in
    codex|claude) export AUTO_BMAD_EXECUTOR="$2" ;;
    *) echo "auto-bmad: --executor expects codex or claude" >&2; exit 1 ;;
  esac
  shift 2
fi
case "${1:-}" in
  plan) s=plan_run ;;
  preflight) s=preflight ;;
  profile) s=write_profile ;;
  spec) s=read_spec ;;
  sync) s=sync_sprint ;;
  questions) s=open_questions ;;
  window) s=window ;;
  worktree) s=worktree ;;
  ext) s=ext ;;
  stats) s=stats ;;
  story-finish) s=story_finish ;;
  verify) s=verify ;;
  setup) s=setup ;;
  roles) s=roles ;;
  evidence) s=evidence ;;
  land) s=land ;;
  stub) s=stub ;;
  test) s=testrun ;;
  agent-config) s=agent_config ;;
  doctor) s=doctor ;;
  engine) s=engine ;;
  agent-smoke) s=agent_smoke ;;
  agent) s=agent_dispatch ;;
  run) s=run_queue ;;
  ""|-h|--help)
    echo "usage: auto-bmad [--executor codex|claude] <plan|preflight|profile|spec|sync|questions|window|worktree|ext|stats|story-finish|verify|setup|roles|evidence|land|stub|test|agent-config|doctor|engine|agent-smoke|agent|run> [args]"
    exit 0 ;;
  *) echo "auto-bmad: unknown command: $1" >&2; exit 1 ;;
esac
shift
exec python3 "$here/scripts/$s.py" "$@"
